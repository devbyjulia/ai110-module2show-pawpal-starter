classDiagram
    %% Final UML for PawPal+, matching pawpal_system.py.

    class Owner {
        +str name
        +int available_minutes = 60
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
        +filter_tasks(pet_name: str|None = None, completed: bool|None = None) list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +edit_task(task: Task, **changes) None
        +complete_task(task: Task, on: date|None = None) Task
        +remove_task(task: Task) None
    }

    class Task {
        <<dataclass eq=False>>
        +str description
        +int duration_minutes
        +str time = ""
        +str priority = "medium"
        +str frequency = "daily"
        +date|None due_date = None
        +bool completed = False
        +date|None last_completed = None
        +str pet_name = ""
        +__post_init__() None
        +mark_complete(on: date|None = None) Task
        +is_due_today(today: date|None = None) bool
    }

    class Scheduler {
        +Owner owner
        +list~Task~ plan
        +list~Task~ skipped
        +generate_plan(today: date|None = None) list~Task~
        +sort_by_priority(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +detect_conflicts(tasks: list~Task~|None = None) list~str~
        +explain_plan() str
    }

    class Rules {
        <<module constants>>
        PRIORITY_RANK : high=0, medium=1, low=2
        RECURRENCE_DAYS : daily=1, weekly=7
        TIME_PATTERN : 24-hour "HH:MM"
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Task ..> Task : mark_complete() creates next occurrence
    Task ..> Pet : pet_name set by add_task()
    Scheduler --> "1" Owner : plans for
    Scheduler --> "0..*" Task : plan / skipped
    Task ..> Rules : validates against
    Scheduler ..> Rules : sorts by priority rank

    note for Scheduler "generate_plan: pick due tasks by priority to fit\navailable_minutes, then order the plan by time.\ndetect_conflicts warns on shared start times, never raises."
